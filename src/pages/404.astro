---
// Cloudflare Pages serves dist/404.html with status 404 for paths that do not exist.
// Without this file Pages treats the project as a SPA and answers every unknown path
// with index.html and status 200 (soft 404).
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found | MOP" description="The page you are looking for does not exist." noindex={true}>
  <main class="page">
    <h1>404</h1>
    <p lang="en">Sorry, this page does not exist.</p>
    <p lang="zh-Hant">抱歉，找不到這個頁面。</p>
    <p lang="ko">죄송합니다. 페이지를 찾을 수 없습니다.</p>
    <nav class="links">
      <a href="/">MOP Map</a>
      <a href="/en/spot">Okinawa Spots (English)</a>
      <a href="/zh/spot">沖繩景點（中文）</a>
    </nav>
  </main>
</Layout>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; padding: 2rem 1rem; text-align: center; background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 50%, #4dd0e1 100%); color: #006064; }
  h1 { font-size: 4rem; margin: 0 0 1rem; }
  p { margin: 0; font-size: 1.1rem; }
  .links { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: 2rem; }
  .links a { padding: 0.8rem 1.5rem; border-radius: 30px; background: #fff; color: #00838f; font-weight: 700; text-decoration: none; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1); }
</style>
