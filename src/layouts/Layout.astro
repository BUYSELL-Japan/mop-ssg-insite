---
import { getLanguageFromPath } from '../utils/language';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  alternateUrls?: {
    en?: string;
    zh?: string;
    ko?: string;
  };
  noindex?: boolean;
}

const { title, description, ogImage, ogUrl, alternateUrls, noindex = false } = Astro.props;
const currentLanguage = getLanguageFromPath(Astro.url.pathname);

const defaultTitle = currentLanguage === 'zh'
  ? '沖繩旅遊指南 | 發現美麗島嶼的魅力'
  : 'Okinawa Guidebook | Discover the Charm of Beautiful Islands';

const defaultDescription = currentLanguage === 'zh'
  ? '為您介紹沖繩的美麗風景、豐富文化和溫馨體驗。'
  : 'Introducing the beautiful scenery, rich culture, and heartwarming experiences of Okinawa.';

const pageTitle = title || defaultTitle;
const pageDescription = description || defaultDescription;
// build.format 'file' gives pathnames like /en/spot.html; Cloudflare Pages serves them as /en/spot
const cleanPathname = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const pageUrl = ogUrl || `${Astro.url.origin}${cleanPathname}`;
// Share image for pages without their own photo (restaurants, spot index, ...): Minna Beach,
// 1200x630, also used by the map app (MOP-Okinawa index.html). Spot pages pass their own photo.
const DEFAULT_OG_IMAGE = 'https://s3geojsonnew.s3.ap-southeast-2.amazonaws.com/og/mop-og-1200x630.jpg';
const shareImage = ogImage || DEFAULT_OG_IMAGE;
---

<!doctype html>
<html lang={currentLanguage}>
	<head>
		<meta charset="UTF-8" />
		<!-- Google Tag Manager -->
		<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-PQ254JK9');</script>
		<!-- End Google Tag Manager -->
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		{noindex && <meta name="robots" content="noindex" />}
		<title>{pageTitle}</title>
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content={shareImage} />
		{!ogImage && <meta property="og:image:width" content="1200" />}
		{!ogImage && <meta property="og:image:height" content="630" />}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={pageUrl} />
		<meta property="twitter:title" content={pageTitle} />
		<meta property="twitter:description" content={pageDescription} />
		<meta property="twitter:image" content={shareImage} />

		<link rel="canonical" href={pageUrl} />

		<!-- hreflang tags for multilingual SEO (zh pages are Traditional Chinese) -->
		{alternateUrls?.en && <link rel="alternate" hreflang="en" href={alternateUrls.en} />}
		{alternateUrls?.zh && <link rel="alternate" hreflang="zh-Hant" href={alternateUrls.zh} />}
		{alternateUrls?.ko && <link rel="alternate" hreflang="ko" href={alternateUrls.ko} />}
		{alternateUrls?.en && <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />}

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-Q8W5Y2G7QW"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());

		  gtag('config', 'G-Q8W5Y2G7QW');
		</script>
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PQ254JK9"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<slot />
	</body>
</html>

<style is:global>
	html {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', 'Yu Gothic', YuGothic, sans-serif;
		line-height: 1.6;
	}
	
	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		background: #f5f5f5;
		color: #333;
	}

	* {
		box-sizing: border-box;
	}

	img {
		max-width: 100%;
		height: auto;
	}
</style>