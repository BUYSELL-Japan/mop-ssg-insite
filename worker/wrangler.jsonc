{
  "name": "mop-insite-proxy",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-04-03",
  "routes": [
    {
      "pattern": "mop-insite.com/*",
      "zone_name": "mop-insite.com"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}